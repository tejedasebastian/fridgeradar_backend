# --- Obligatorias ---
# Cadena de conexión a PostgreSQL. No hay valor por defecto: sin esto la app
# no arranca. Ejemplo (reemplazá USER y PASSWORD por los de tu instalación):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/fridge_inventory
DATABASE_URL=

# Secreto para firmar JWT. Debe tener >= 32 caracteres y ser aleatorio.
# Generá uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# No reutilices el de otro entorno ni lo commitees.
JWT_SECRET=

# --- Opcionales ---
ENVIRONMENT=local

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Set your Gemini API key for AI chat feature
GEMINI_API_KEY=

# RF-COM-007: rate limiting (set to "false" to disable, e.g. in tests)
RATE_LIMIT_ENABLED=true

# RF-COM-012: background scan of expiry alerts
ENABLE_SCHEDULER=true
SCAN_INTERVAL_MINUTES=60

# Base de datos para pytest. Si se deja vacía, los tests usan DATABASE_URL.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/fridge_inventory_test
TEST_DATABASE_URL=
